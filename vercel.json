{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "echo 'Backend: no build step'",
  "installCommand": "cd server && npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/server/server.js" }
  ],
  "functions": {
    "server/server.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
