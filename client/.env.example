# Environment variables for RINK Global Services Client
# Copy this file to .env.local and fill in your values

# API Base URL - defaults to same origin + /api
# For local development: http://localhost:5001
# For production: https://api.rinkglobal.com or https://rinkglobal.com/api
VITE_API_BASE_URL=https://rinkglobal.com/api
