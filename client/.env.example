# RINK Global Services — Frontend env template
# Copy this file to .env.local and fill in real values.

# Base URL of the API gateway (Express). For local dev, point at your server.
# In production this should be your deployed backend, e.g. https://api.rinkglobal.com
VITE_API_BASE_URL=http://localhost:5001

# Supabase project credentials (anon key is safe to expose to the browser).
# Find these in Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
