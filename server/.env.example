# RINK Global Services — Backend env template
# Copy this file to .env and fill in real values. Never commit the real .env.

# URL of the FastAPI ML service (Render / Railway / Fly).
ML_API_URL=http://localhost:8000

# Groq API key for the AI Assistant. Get one at https://console.groq.com.
GROQ_API_KEY=your-groq-api-key
# Optional: override the default Groq model.
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase server-side credentials (used only to verify access tokens).
# Anon key is sufficient for getUser(token).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://rinkglobal.com,https://www.rinkglobal.com

# Port for local dev (Vercel ignores this).
PORT=5001

# Optional shared secret with FastAPI — when set, ML service rejects
# requests that don't carry X-Gateway-Secret: <same value>.
GATEWAY_SECRET=

# --- Welcome email (Resend) ---------------------------------------------
# Sign up at https://resend.com, verify a domain, and paste the API key.
# Leave RESEND_API_KEY blank to disable welcome emails (POST /api/welcome-email
# will return 503 in that case).
RESEND_API_KEY=
WELCOME_FROM_EMAIL=RINK <hello@rinkglobal.com>
# Used by /api/contact as the From: address (defaults to WELCOME_FROM_EMAIL).
CONTACT_FROM_EMAIL=RINK <hello@rinkglobal.com>
# Where contact form submissions are forwarded.
TEAM_EMAIL=hello@rinkglobal.com

# URLs used inside the welcome email body.
APP_URL=https://rinkglobal.com
DOCS_URL=https://docs.rinkglobal.com

# --- Passkeys (WebAuthn) -----------------------------------------------
# Service-role key — REQUIRED for passkey + OAuth issuance flows. Treat as
# a top-tier secret; it bypasses RLS. Never commit, never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# Relying party identifiers. RP_ID must match the apex of the URL the user
# visits (no protocol, no port). For localhost development, leave as "localhost".
PASSKEY_RP_NAME=RINK Global Services
PASSKEY_RP_ID=rinkglobal.com
PASSKEY_RP_ORIGIN=https://rinkglobal.com
