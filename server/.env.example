# RINK Global Services — Backend env template
# Copy this file to .env and fill in real values. Never commit the real .env.

# URL of the FastAPI ML service (Render / Railway / Fly).
ML_API_URL=http://localhost:8000

# Groq API key for the AI Assistant. Get one at https://console.groq.com.
GROQ_API_KEY=your-groq-api-key
# Optional: override the default Groq model.
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase server-side credentials (used only to verify access tokens).
# Anon key is sufficient for getUser(token).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://rinkglobal.com,https://www.rinkglobal.com

# Port for local dev (Vercel ignores this).
PORT=5001
