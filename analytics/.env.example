# RINK Data Analytics — frontend env. Copy to .env.local for local dev.
# All variables MUST be prefixed VITE_ to be exposed to the client bundle.

# Backend API (the existing Express gateway, shared with rinkglobal.com).
VITE_API_BASE_URL=https://api.rinkglobal.com

# Supabase auth (same project as rinkglobal.com so sessions are unified).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Marketing site URL (for footer / legal links pointing back).
VITE_MARKETING_URL=https://rinkglobal.com
